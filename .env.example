# Server runtime; use production on Render. Never put server secrets in REACT_APP_* variables.
NODE_ENV=development
PORT=8080
MONGO_URL=mongodb://127.0.0.1:27017/spendwise
# Existing SRV failure fallback; production fallback policy needs review (Phase 1).
MONGO_LOCAL_URL=mongodb://127.0.0.1:27017/spendwise
JWT_SECRET=replace-with-a-long-random-secret
FIREBASE_PROJECT_ID=your-firebase-project-id
FRONTEND_URL=http://localhost:3000
