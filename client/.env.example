# Include /api/v1 in the API URL for a separate backend service.
REACT_APP_API_URL=http://localhost:8080/api/v1
# Firebase web configuration is public; never put service-account keys here.
REACT_APP_FIREBASE_API_KEY=your-public-web-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_APP_ID=your-web-app-id
